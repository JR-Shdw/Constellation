# versions.env — image versions for cmdb
# This file is committed to git — safe to share
# To upgrade: change version here, push, pipeline validates + deploys

# Stack
POSTGRES_VERSION=18-trixie
PYTHON_VERSION=3.12-slim
PYTHON_TOOLS_VERSION=3.12-slim-bookworm
NGINX_VERSION=stable-alpine

# CI (Woodpecker pipelines)
ALPINE_VERSION=3.23
DOCKER_CLI_VERSION=29-cli
TRIVY_VERSION=0.70.0

# Security scanning (Woodpecker pipelines)
SYFT_VERSION=v1.42.4
COSIGN_VERSION=v3.0.6
NUCLEI_VERSION=v3.7.1

# Dev / CI tools (pre-commit hooks + Woodpecker lint-and-sast)
RUFF_VERSION=0.15.13
DETECT_SECRETS_VERSION=1.5.0

# Python dependencies (api/requirements.txt)
FASTAPI_VERSION=0.135.3
UVICORN_VERSION=0.44.0
SQLALCHEMY_VERSION=2.0.49
ASYNCPG_VERSION=0.31.0
PYDANTIC_VERSION=2.12.5
HTTPX_VERSION=0.28.1
CRONITER_VERSION=6.2.2
CRYPTOGRAPHY_VERSION=46.0.6
