# Copier en .env.local et adapter si besoin (defaut OK pour tests iso-prod).
# Le fichier .env.local n'est PAS commite — uniquement local pour stress tests.

# Stack
POSTGRES_DB=cmdb
POSTGRES_USER=cmdb
POSTGRES_PASSWORD=cmdb_local_pw

# API auth — secrets random pour le test, ne pas reutiliser ailleurs
API_SECRET_KEY=local_secret_key_for_iso_prod_testing_only_change_me_if_needed
COLLECT_TOKEN=local_collect_token_iso_prod_testing_only_change_me_if_needed
TOKEN_HMAC_KEY=local_hmac_key_iso_prod_testing_only_change_me_if_needed

# Iso prod : 4 workers + pool 10/20 — meme que vega
UVICORN_WORKERS=4
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=10

# Pool logger toutes les 10s pour observation rapide
DB_POOL_LOG_INTERVAL=10
DB_POOL_WARN_FREE=5

# pg_stat_activity logger plus aggressif en local pour iterer vite
DB_ACTIVITY_LOG_INTERVAL=15
DB_ACTIVITY_SLOW_SECONDS=5
DB_ACTIVITY_WARN_TOTAL=25

# PG sizing — plus petit que prod (16 GB → on n'a pas besoin de 1 GB)
PG_SHARED_BUFFERS=256MB
PG_MAX_CONNECTIONS=200
