# CMDB Constellation — Environment Variables
# Copy to .env and fill in the values: cp env.example .env
# Or generate secrets automatically: make secrets

# Domain & Reverse Proxy
# Public domain for HTTPS access (via Traefik + Authelia)
CMDB_DOMAIN=cmdb.example.com

# Allowed origins for CORS (comma-separated)
# Only these domains can make browser requests to the API
# Example: https://cmdb.example.com,https://admin.example.com
ALLOWED_ORIGINS=https://cmdb.example.com

# Authelia middleware name (from Traefik dynamic config)
# Examples: authelia@file | authelia-forwardauth@file
AUTHELIA_MIDDLEWARE=authelia@file

# Network
# IMPORTANT: A private network (VPN/WireGuard) is strongly recommended.
# The CMDB API handles sensitive infrastructure data (CVEs, packages,
# network exposure, credentials). Do NOT expose it on the public internet.
#
# IP where the API listens for collection (Ansible, Trivy, scripts)
WG1_IP=10.0.1.1
# IP where the frontend listens for direct internal access
WG_IP=10.0.0.1

# PostgreSQL
# Database is internal only (Docker network, no port exposed)
POSTGRES_DB=cmdb
POSTGRES_USER=cmdb
POSTGRES_PASSWORD=           # REQUIRED — use: openssl rand -hex 24

# PostgreSQL tuning (defaults sized for ~1k nodes / 2 GB host RAM free)
# Presets — copy the row that matches your fleet size:
#
#   Scale    shared_buffers  eff_cache  work_mem  wal_buf  max_wal  maint_wm  workers
#   100      256MB           1GB        8MB       8MB      512MB    64MB      2
#   1 000    1GB             4GB        32MB      64MB     2GB      256MB     4   (default)
#   5 000    2GB             8GB        64MB      128MB    4GB      512MB     8
#   10 000   4GB             12GB       128MB     256MB    8GB      1GB       16
#
# Rule of thumb: shared_buffers ~25% of host RAM, effective_cache_size ~75%.
# UVICORN_WORKERS scales with concurrent ingestion (Ansible + Trivy + Wazuh + OpenCVE).
# Override any variable individually — unset = default below.
PG_SHARED_BUFFERS=1GB
PG_EFFECTIVE_CACHE_SIZE=4GB
PG_WORK_MEM=32MB
PG_MAINTENANCE_WORK_MEM=256MB
PG_WAL_BUFFERS=64MB
PG_MAX_WAL_SIZE=2GB
PG_CHECKPOINT_TIMEOUT=15min
PG_RANDOM_PAGE_COST=1.1       # 1.1 for SSD, 4.0 for spinning disk
# PG max_connections must accommodate (DB_POOL_SIZE + DB_MAX_OVERFLOW)
# × UVICORN_WORKERS plus sync containers and admin sessions. Default 400
# fits 4 workers × 30 + sync/ansible/scheduler + large headroom.
PG_MAX_CONNECTIONS=400

# SQLAlchemy pool — per uvicorn worker. Effective concurrent DB
# connections = (DB_POOL_SIZE + DB_MAX_OVERFLOW) × UVICORN_WORKERS.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=300           # seconds — recycle stale connections
DB_POOL_TIMEOUT=10            # fail-fast wait (seconds) for a free slot
DB_POOL_LOG_INTERVAL=60       # log pool stats every N seconds (0 = off)
DB_POOL_WARN_FREE=3           # log WARNING when free slots ≤ this

# Server-side pg_stat_activity logger — fires WARNING when slow
# queries / blocked queries / connection saturation appear. Snapshot
# is also exposed on GET /api/v1/health/db (auth required).
DB_ACTIVITY_LOG_INTERVAL=60   # interval seconds (0 = off)
DB_ACTIVITY_SLOW_SECONDS=10   # query age that triggers a slow-query warn
DB_ACTIVITY_WARN_TOTAL=80     # warn when total connections ≥ this

# Postgres-side logging — emitted by PG itself into stderr / docker logs
PG_LOG_MIN_DURATION_MS=1000   # log queries running ≥ this many ms
PG_LOG_LOCK_WAITS=on          # log lock waits longer than deadlock_timeout
PG_LOG_TEMP_FILES=10MB        # log temp files spilled to disk
PG_DEADLOCK_TIMEOUT=1s        # how long to wait before logging lock waits

# Anti-zombie — kill stuck transactions and detect dead clients before they
# exhaust the pool. Mirrored on the asyncpg side via server_settings.
# statement_timeout=0 means disabled: too many legit hot paths run > 30s
# (CVE ingestion upserts, v_all_cves exports, OpenCVE sync). Apply per-endpoint
# via `SET LOCAL statement_timeout` if a specific route needs a cap.
PG_IDLE_IN_TX_TIMEOUT_MS=60000   # kill idle-in-transaction sessions ≥ this (ms)
PG_STATEMENT_TIMEOUT_MS=0        # 0 = disabled, set ms value to cap all statements
# Per-endpoint timeout profiles applied via SET LOCAL statement_timeout.
# Opt-in: a handler calls `set_statement_timeout(db, "batch"|"long")` to
# cap its own transaction. Layered on top of PG_IDLE_IN_TX_TIMEOUT_MS.
PG_STATEMENT_TIMEOUT_BATCH_MS=3600000  # 1 h — large côté serveur, on tune par worker via CMDB_INGEST_TIMEOUT
PG_STATEMENT_TIMEOUT_LONG_MS=7200000   # 2 h — admin/cleanup/full sync
PG_TCP_KEEPALIVES_IDLE=60        # send first keepalive probe after N idle seconds
PG_TCP_KEEPALIVES_INTERVAL=10    # probe interval (seconds)
PG_TCP_KEEPALIVES_COUNT=3        # drop conn after N failed probes (~90s to detect dead client)

# API health watchdog — pool/PG saturation tripwires + Matrix alerts
# Background loop in lifespan, one tick per WATCHDOG_INTERVAL_SECONDS,
# per-tripwire state machine with cooldown. Single Matrix push across
# workers via PG advisory lock. Set WATCHDOG_ENABLED=false to disable.
# Matrix routing: trigger_type "api_health" -> matrix_room_systems
# (configurable via Settings UI) with fallback to matrix_room_security.
WATCHDOG_ENABLED=true
WATCHDOG_INTERVAL_SECONDS=30
WATCHDOG_COOLDOWN_SECONDS=300                 # min seconds between repeat alerts
WATCHDOG_IDLE_IN_TX_THRESHOLD_SECONDS=60
WATCHDOG_QUERY_STUCK_THRESHOLD_SECONDS=180     # 3min — supporte les ingestions batch normales sans spam
WATCHDOG_LOCK_PILEUP_THRESHOLD=5              # # blocked queries to alert
WATCHDOG_OVERFLOW_ALERT_THRESHOLD=10          # # overflow slots in use to alert

# API Authentication
# Admin API key (read endpoints, lifecycle, settings)
API_SECRET_KEY=              # REQUIRED — use: openssl rand -hex 32

# Collection token (write endpoints: /nodes/report, /cves/report, etc.)
# Share this with Ansible, Trivy scripts, backup scripts
COLLECT_TOKEN=               # REQUIRED — use: openssl rand -hex 32

# Timeout HTTP côté scripts sync (sync_wazuh, sync_opencve, sync_*) pour
# leurs POST vers l'API CMDB. Avant 2026-05-14 c'était hardcodé à 30s,
# trop court pour les gros payloads (Wazuh sur un node avec des centaines
# de CVE peut dépasser). 1200s = 20min, large pour absorber les pics de
# charge sans couper la socket en cours d'ingestion (la cause des tx
# orphelines côté serveur, post-mortem incident 2026-05-11).
CMDB_INGEST_TIMEOUT=1200

# OpenCVE Sync (optional)
# Self-hosted OpenCVE v2 instance URL (internal API, for sync scripts)
OPENCVE_URL=http://opencve-web:8000
OPENCVE_USER=
OPENCVE_PASSWORD=
# OpenCVE browser URL (for clickable links in CVE detail panel)
OPENCVE_WEB_URL=https://opencve.example.com

# Wazuh Sync (optional)
# Wazuh manager API (internal network)
WAZUH_URL=https://wazuh-manager:55000
WAZUH_USER=wazuh-wui
WAZUH_PASSWORD=

# Token HMAC Key (optional)
# Persistent key for hashing API tokens (HMAC-SHA512)
# If not set, an ephemeral key is generated (tokens invalidated on restart)
TOKEN_HMAC_KEY=              # Recommended — use: openssl rand -hex 32

# Woodpecker CI (optional)
# Woodpecker API URL and personal access token
WOODPECKER_URL=https://ci.example.com
WOODPECKER_TOKEN=

# Gitea (optional)
# Gitea API URL and token (for repository metadata)
GITEA_URL=https://gitea.example.com
GITEA_TOKEN=

# GitLab (optional)
# GitLab API URL and personal access token
GITLAB_URL=
GITLAB_TOKEN=

# Forgejo (optional)
# Forgejo API URL and token (same API as Gitea)
FORGEJO_URL=
FORGEJO_TOKEN=

# rhorizon (optional)
# Secrets vault integration — loads secrets at startup instead of .env
# Also configurable via Settings UI > CI/CD tab
VAULT_URL=                   # e.g. http://rhorizon-api:8200
VAULT_TOKEN=                 # rh_xxx — scope secrets:r

# Feature Flags
# Enable Swagger UI (/api/docs) and ReDoc (/api/redoc)
# WARNING: Disable in production — exposes full API schema
ENABLE_SWAGGER=false

# API Workers
# Number of uvicorn workers (default: 4)
UVICORN_WORKERS=4

# Rate limiting & brute-force (optional)
# Defaults are light (VPN + SSO already gate access). Tighten these if
# the instance is shared or reachable from a wider LAN.
# Rate limit: sliding window per source IP (in-memory, per uvicorn worker).
RATE_LIMIT_REQUESTS=2000
RATE_LIMIT_WINDOW_SECONDS=60
# Brute-force protection: counts failed Bearer token attempts per IP.
# After BF_MAX_FAILURES within BF_WINDOW_SECONDS, ban for BF_BAN_SECONDS.
BF_MAX_FAILURES=30
BF_WINDOW_SECONDS=300
BF_BAN_SECONDS=300

# Notifications (optional)
# Matrix (configured via Settings UI, stored in DB)
# MATRIX_URL, MATRIX_TOKEN, MATRIX_ROOM_* are set in the web UI
#
# Email (configured via Settings UI, stored in DB)
# SMTP_HOST, SMTP_FROM, ALERT_EMAIL are set in the web UI


# Secret rotation — SOP
#
# Production runs with rhorizon (Resurgamus Horizon) as the source of truth for
# secrets. The .env file only carries POSTGRES_PASSWORD (needed at container
# boot, before the API can talk to rhorizon) and VAULT_URL / VAULT_TOKEN (the
# handshake credentials). Every other secret — API_SECRET_KEY, COLLECT_TOKEN,
# TOKEN_HMAC_KEY, *_TOKEN for forges/CI — is pulled from rhorizon at startup
# via `_load_vault_secrets()` (api/app/main.py) and NEVER stored in .env in
# production.
#
# Rotation cadence: every secret every 12 months, or immediately after:
#   - a suspected compromise (leaked log, lost laptop, ex-admin, etc.)
#   - an incident where the secret may have been exfiltrated
#   - a dependency/container CVE that could expose process memory
#
# Automated reminder: the scheduler job `secret-rotation-check` runs daily
# at 10:15 UTC. For each vault secret, the scan does one of three things
# (alerts land in `matrix_room_security`):
#
#   age  action
#   >=330 warning      - rotate via rhorizon + `docker compose restart api`
#   >=365 auto-rotate  - cmdb-secret-key only (cold-path admin key).
#                        New value written to rhorizon, Matrix notification
#                        reminds the operator to restart api to activate it.
#   any   cleared      - rotation detected (rhorizon `updated_at` advanced)
#
# Only `cmdb-secret-key` is auto-rotatable (no deployed clients, single
# consumer = the API itself). All other secrets are alert-only because
# rotating them needs coordination with external systems (Ansible vault,
# Woodpecker, Gitea, OpenCVE, etc.).
#
# Primary procedure: rhorizon
# (API scope required: secrets:w, namespace cmdb)
#
#   Secret (rhorizon name)   | Impact on CMDB                      | Action after rotation
#   cmdb-secret-key          | Admin Bearer key rotation           | curl -H 'Authorization: Bearer $NEW' /api/v1/health
#   cmdb-collect-token       | Invalidates Ansible/Trivy/Wazuh     | update the token on every collector (ansible-vault edit)
#   cmdb-token-hmac-key      | ! Invalidates ALL DB tokens         | recreate every token via Settings > Tokens
#                            | (they can't be rehashed)            |
#   cmdb-woodpecker-token    | Triggers & pipeline reads fail      | paste new token in Woodpecker UI user settings
#   cmdb-gitea-token         | Repo scraping fails                 | regenerate in Gitea > Settings > Applications
#   cmdb-gitlab-token        | Same as Gitea for GitLab            | regenerate in GitLab > Access Tokens
#   cmdb-forgejo-token       | Same as Gitea for Forgejo           | regenerate in Forgejo > Settings > Applications
#   cmdb-opencve-password    | OpenCVE sync fails                  | reset in OpenCVE web UI
#
# Step by step:
#   1. Generate the new value: openssl rand -hex 32 (or regenerate in the upstream service)
#   2. rhorizon CLI (or UI): set cmdb/<name> = <new>
#   3. Restart the API to pull the new secret: docker compose restart api
#   4. Verify: curl -H 'Authorization: Bearer $NEW_SECRET_KEY' https://cmdb.example.com/api/v1/health
#   5. Archive the event in the audit log (Settings > Audit > filter target_type=secret_rotation)
#
# NO .env edit needed for these — rhorizon is the single source of truth.
#
# Fallback: .env only (dev, bootstrap, rhorizon unreachable)
# Used when the vault is not configured or sealed beyond recovery. Same
# commands above, but edit /opt/cmdb/.env and `docker compose up -d api` after.
# Once rhorizon is reachable again, seed the secrets back into the vault and
# blank them in .env (empty string = "fall back to vault" is NOT the case —
# .env wins when set, so leave them unset to re-enable vault sourcing).
#
# POSTGRES_PASSWORD (always in .env — bootstrap dependency)
# The DB is up before the API, so this one stays in .env + PG user password.
# Rotate with:
#   1. NEW=$(openssl rand -hex 24)
#   2. docker exec cmdb_postgres psql -U cmdb -c "ALTER USER cmdb PASSWORD '$NEW'"
#   3. sed -i "s|^POSTGRES_PASSWORD=.*|POSTGRES_PASSWORD=$NEW|" /opt/cmdb/.env
#   4. docker compose up -d api
